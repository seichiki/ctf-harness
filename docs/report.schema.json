{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-bearing CTF report",
  "type": "object",
  "properties": {
    "candidate": {"type": "string", "description": "One complete candidate, or an empty string"},
    "input_sha256": {"type": "object", "additionalProperties": {"type": "string"}},
    "method": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "reproduction_commands": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "array", "items": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"], "additionalProperties": false}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["candidate", "input_sha256", "method", "evidence", "reproduction_commands", "artifacts", "limitations"],
  "additionalProperties": false
}
